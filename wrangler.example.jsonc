{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oakhouse-room-monitor",
	"account_id": "REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"vars": {
		"TARGET_URL": "https://www.oakhouse.jp/eng/house/1142",
		"ROOMS_URL": "https://www.oakhouse.jp/eng/house/1142#room",
		"PROPERTY_NAME": "GRAN KOBE",
		"AYN_TARGET_URL": "https://www.ayntec.com/pages/shipment-dashboard?section_id=main-page",
		"AYN_DASHBOARD_URL": "https://www.ayntec.com/pages/shipment-dashboard",
		"FX_API_URL": "https://api.twelvedata.com/time_series",
		"FX_PAGE_URL": "https://mercati.ilsole24ore.com/tassi-e-valute/valute/contro-euro/cambio/JPYVS.FX",
		"FAILURE_THRESHOLD": "3",
		"FETCH_TIMEOUT_MS": "15000"
	},
	"triggers": {
		"crons": []
	},
	"secrets": {
		"required": [
			"TELEGRAM_BOT_TOKEN",
			"TELEGRAM_CHAT_ID",
			"TELEGRAM_WEBHOOK_SECRET",
			"TWELVE_DATA_API_KEY"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"kv_namespaces": []
}
